;; Minimal BONE config -- fills in sensible defaults for :db (data/bone-db),
;; :logging (stderr :info) and :ingest ({:fetch {:limit 50}}).  See
;; config.edn.example for the fully annotated template.

{:mailbox {:type :maildir
           :path "/path/to/your/Maildir"
           :folder "INBOX"}

 :sources [{:name "my-source"
            :list "list-id.example.org"}]}
