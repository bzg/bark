{ ;; ---- Connection --------------------------------------------------------

 ;; Mail source — IMAP or Maildir. :folder defaults to "INBOX".
 :mailbox {:type     :imap
           :host     "imap.example.com"
           :port     993
           :ssl      true
           :user     "imap-login@example.com"
           :password "secret"
           :folder   "INBOX"}
 ;; Maildir alternative:
 ;; :mailbox {:type :maildir :path "/home/me/Mail" :folder "INBOX"}

 :db {:path "data/bark-db"}

 ;; ---- Who monitors what --------------------------------------------------

 :sources [;; Mailing list — :list matches the List-Id identifier
           ;; (bare, no angle brackets).
           {:name                  "public-list"
            :list                  "bugs.example.org"
            :base-url              "https://bark.example.org/public/public-list/"
            :list-archive          "https://list.example.org"
            :archive-format-string "https://list.example.org/%s"
            ;;
            ;; Maintainers seed initial tenures. The FIRST entry is the
            ;; lead (can remove others, cannot self-remove). :since
            ;; restricts privileges to emails dated on or after that day.
            ;; After startup, "Add/Remove maintainer:" directives mutate
            ;; the live tenure history in the DB (exported to meta.json
            ;; and docs.html).
            ;;
            ;; :maintainers [{:email "lead@example.org"}
            ;;               {:email "co-maint@example.org" :since "2025-06-01"}]
            ;;
            ;; :notifications {:enable false}  ;; silence this source
            }

           ;; Alias — matches X-Original-To / Envelope-To / X-Envelope-To
           ;; / Delivered-To.
           {:name  "team-alias"
            :alias "security@example.com"}

           ;; Dedicated mailbox — matches Delivered-To.
           {:name "direct-inbox"
            :to   "inbox@example.com"}]

 ;; ---- Ingestion -----------------------------------------------------------

 ;; :initial-fetch — first-run fetch window (integer count, "Nd/w/m/y"
 ;; duration, or "yyyy-MM-dd" date). CLI: --initial-fetch 4d.
 ;; :max-size / :max-attachment-size — byte limits (optional).
 :ingest {:initial-fetch 50
          ;; :max-size 1048576
          ;; :max-attachment-size 1048576
          }

 ;; ---- Customization -------------------------------------------------------

 ;; Global labels (optional) — subject tag overrides per report type.
 ;; Merged over defaults; per-source overrides global.
 ;; :labels {:bug ["BUG" "DEFECT"] :request ["POLL" "FR" "TODO" "RFE"]}
 ;; Defaults: :bug ["BUG"]  :patch ["PATCH"]  :request ["POLL" "FR" "TODO"]
 ;;           :announcement ["ANN" "ANNOUNCEMENT"]
 ;;           :release ["REL" "RELEASE"]  :change ["CHG" "CHANGE"]

 ;; Global commands (optional) — per-command overrides. Merged over
 ;; defaults; per-source overrides global. Each entry is a map with
 ;; any of :words, :scope, :report-types.
 ;;
 ;; :commands {:closed   {:words ["Canceled" "Fixed" "Wontfix"]}
 ;;            :acked    {:words ["Approved" "LGTM"] :scope :maintainer}
 ;;            :deadline {:report-types #{:bug :patch :request :change}}
 ;;            :unclosed {:scope :setter-or-maintainer}}
 ;;
 ;; :scope — :user, :maintainer, or :setter-or-maintainer.
 ;; Last is only valid on :un* directives whose attr is ref-tracked
 ;; (see the manual for the full list of command IDs and defaults).

 ;; Restrict detected + exported report types (optional).
 ;; Default: all types. Per-source overrides global.
 ;; :report-types #{:bug :patch :request :announcement :release :change}

 ;; ---- Lifecycle -----------------------------------------------------------

 ;; Expiry rules (optional) — auto-close open reports per report type.
 ;; Per-source overrides global. Each rule:
 ;;   :inactive-after — duration, ISO date, or :deadline  [required]
 ;;   :max-status     — 0=none, 1=acked, 2=owned, 3=acked+owned [optional]
 ;;   :max-priority   — 0..3 (urgent+important)           [optional]
 ;; Conjunctive. The "Expiry: <date-or-duration>" directive overrides
 ;; these rules per report.
 ;;
 ;; :expiry {:announcement {:inactive-after "30d"}
 ;;          :release      {:inactive-after "6w"}
 ;;          :change       {:inactive-after "3m"}
 ;;          :bug          {:inactive-after "1000d" :max-status 0 :max-priority 0}
 ;;          :request      {:inactive-after "1000d" :max-status 0}}

 ;; Command aliases (optional) — old syntax → current form. Useful when
 ;; re-parsing archives after a syntax change.
 ;; :command-aliases {"Unacked"     "Not acked"
 ;;                   "Undeadline"  "No deadline"
 ;;                   "Unexpiry"    "No expiry"}

 ;; Awaiting-reply delay (optional) — ⌚ flag when last email is from a
 ;; maintainer and no reply within this duration. Default: "14d".
 ;; Global or per-source (per-source wins).
 ;; :awaiting-delay "14d"

 ;; ---- Exports -------------------------------------------------------------

 ;; Export formats (optional) — per-type feed files generated.
 ;; Default: ["json" "org" "rss"]. Per-source overrides global.
 ;; :export-formats ["json" "rss"]

 ;; The following are CLI-only (bb export):
 ;;   --page-size 100           HTML pagination (0/absent = off)
 ;;   --closed-retention 1y     drop reports closed before the cutoff
 ;;                             (accepts duration or ISO date)
 ;;   --topics-filter "a,b"     overrides any per-source :topics-filter.

 ;; Per-source topics filter (optional, vector of strings, case-insensitive):
 ;; {:name "community" :topics-filter ["event" "meetup"]}

 ;; Theme for HTML pages (optional). Resolution order:
 ;;   https://...  → external <link>
 ;;   file:///...   → inline <style> from local file
 ;;   path.css     → inline <style> (relative/absolute path)
 ;;   bare name    → pico-themes CDN. "none" disables theming.
 ;; CLI: bb export --theme org
 ;; :theme "org"

 ;; ---- Notifications -------------------------------------------------------

 ;; Optional — notifications disabled if absent.
 :notifications {:enabled false
                 :smtp {:host     "smtp.example.com"
                        :port     587
                        :tls      true
                        :user     "notify@example.com"
                        :password "secret"
                        :from     "bark@example.com"}}

 ;; ---- Logging -------------------------------------------------------------

 ;; :logging {:file     "logs/bark.log"    ;; optional
 ;;           :level    :warn              ;; :debug :info :warn :error
 ;;           :max-size "10MB"             ;; rotate threshold (default 10MB)
 ;;           :backlog  5                  ;; rotated files kept (default 5)
 ;;           ;; Email logging requires :notifications :smtp.
 ;;           :email    {:to "bark@example.com" :level :error}}

 }
