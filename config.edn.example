{ ;; Default admin email
 :admin "admin@example.com"

 ;; Connection to the monitored mailbox
 :imap {:host     "imap.example.com"
        :port     993
        :ssl      true
        :user     "imap-login@example.com"
        :password "secret"
        :folder   "INBOX"}

 ;; Datalevin database path
 :db {:path "data/bark-db"}

 ;; Theme for HTML pages (optional).
 ;; Short names: "org", "dsfr", "swh", "doric", "lincoln" (from jsDelivr/pico-themes).
 ;; Or a full URL to any CSS file.
 ;; CLI override: bb export --theme org
 ;; Set to "none" to disable theming.
 ;; :theme "org"

 ;; Ingest settings
 :ingest {:initial-fetch 50}

 :sources [
           ;; --- Use-case 1: mailing list ---
           ;; Use :list with the List-Id identifier (inside angle brackets),
           ;; e.g. for a header "List-Id: Org Mode <emacs-orgmode.gnu.org>",
           ;; use "emacs-orgmode.gnu.org" (not the full header value).
           {:name               "public-list"
            :list               "bugs.example.org"
            ;;
	    ;; The Bark admin of this monitored mailbox
            :admin              "lead@example.org"
            ;;
            ;; Maintainers (optional) — seed initial maintainers.
            ;; :since restricts the maintainer to emails dated on or after
            ;; that date (useful when adding someone retroactively without
            ;; granting privileges on older emails).  Omit :since for
            ;; immediate effect on all emails.
            ;; "Add maintainer:" / "Remove maintainer:" directives in
            ;; emails override this list at runtime.
            ;; Note: the admin is NOT automatically a maintainer.
            ;; :maintainers [{:email "lead@example.org" :since "2025-01-01"}
            ;;               {:email "co-maint@example.org"}]
            ;;
            ;; Base URL where this source's public/ directory is served (optional)
            :bark-path "https://bark.example.org/public/public-list/"
            ;;
            ;; URL of the list archive (informational, used in HTML reports)
            :list-archive "https://list.example.org"
            ;;
            ;; When the Archived-At header is not set, build archive
            ;; URLs from message-ids (%s is replaced by the
            ;; message-id).
            :archive-format-string "https://list.example.org/%s"
            }

           ;; --- Use-case 2: email alias ---
           ;; Use :alias when the BARK mailbox receives mail via an alias.
           ;; Matches X-Original-To, Envelope-To, X-Envelope-To, or Delivered-To.
           {:name               "team-alias"
            :alias              "security@example.com"}

           ;; --- Use-case 3: dedicated mailbox ---
           ;; Use :to when the BARK mailbox is the final destination.
           ;; Matches Delivered-To.
           {:name               "direct-inbox"
            :to                 "inbox@example.com"}
           ]

 ;; Direct emails from maintainers:
 ;; When a maintainer sends directly to the BARK inbox (bypassing the
 ;; list or alias), they must signal the target source with either:
 ;;   - An X-Bark-Source: source-name header, or
 ;;   - A [source-name] prefix in the subject.
 ;; The source-name must match a source's :name exactly (case-insensitive).
 ;; Non-maintainer direct emails to :list or :alias sources are ignored.

 ;; Notification settings (optional — notifications disabled if absent)
 :notifications {:enabled true
                 :smtp {:host     "smtp.example.com"
                        :port     587
                        :tls      true
                        :user     "notify@example.com"
                        :password "secret"
                        :from     "bark@example.com"}}

 ;; Global labels (optional) — override built-in subject tag lists.
 ;; Merged on top of defaults; specify only the types you want to change.
 ;; When set per source, it overrides the global value.
 ;;
 ;; Example:
 ;; :labels {:bug ["BUG" "DEFECT"]
 ;;          :request ["POLL" "FR" "TODO" "RFE"]}
 ;; Defaults:
 ;;   :bug          ["BUG"]
 ;;   :patch        ["PATCH"]
 ;;   :request      ["POLL" "FR" "TODO"]
 ;;   :announcement ["ANN" "ANNOUNCEMENT"]
 ;;   :release      ["REL" "RELEASE"]
 ;;   :change       ["CHG" "CHANGE"]

 ;; Global commands (optional) — override built-in body command keywords.
 ;; Merged on top of defaults; specify only the actions you want to change.
 ;; When set per source, it overrides the global value.
 ;;
 ;; Simple form — just override trigger words:
 ;; :commands {:closed ["Canceled" "Fixed" "Resolved" "Wontfix"]
 ;;            :acked  ["Approved" "Reviewed" "LGTM"]}
 ;;
 ;; Extended form — override :words, :scope, and/or :report-types:
 ;; :commands {:acked    {:words ["Approved" "LGTM"]
 ;;                       :scope :maintainer}          ;; restrict to maintainers
 ;;            :deadline {:report-types #{:bug :patch :request :change}}  ;; widen types
 ;;            :closed   ["Canceled" "Fixed" "Wontfix"]}  ;; simple form still works
 ;;
 ;; :scope can be :user (anyone) or :maintainer (maintainer only).
 ;; :report-types replaces the default set for that command.
 ;; Both simple and extended forms can be mixed in the same map.
 ;; These overrides apply to any command ID (triggers and directives):
 ;;   :acked :owned :closed :urgent :important
 ;;   :acked-by :owned-by :closed-by :urgent-by :important-by
 ;;   :unacked :unowned :unclosed :unurgent :unimportant
 ;;   :deadline :undeadline :topic
 ;;
 ;; Default trigger words:
 ;;   :acked     ["Acked" "Confirmed" "Reviewed" "Approved"]
 ;;   :owned     ["Owned" "Handled" "Assigned"]
 ;;   :closed    ["Canceled" "Cancelled" "Resolved" "Applied"
 ;;               "Done" "Fixed" "Closed" "Expired"]
 ;;   :urgent    ["Urgent"]
 ;;   :important ["Important"]

 ;; Expiry rules (optional) — auto-close open reports when age and state
 ;; match configured conditions. Applies to any report type.
 ;; When set per source, it overrides the global value.
 ;;
 ;; Each entry maps a report type to a rule map:
 ;;   :delay         — duration string ("30d", "6w", "3m", "1y") [required]
 ;;   :max-status    — don't expire if activity score > this (0=none, 1=acked,
 ;;                    2=owned, 3=acked+owned) [optional]
 ;;   :max-priority  — don't expire if priority > this (0-3) [optional]
 ;;   :op-answered   — false: don't expire if the OP posted the last reply [optional]
 ;;
 ;; All conditions are conjunctive (all must be true to expire).
 ;;
 ;; Example:
 ;; :expiry {:announcement {:delay "30d"}
 ;;          :release      {:delay "6w"}
 ;;          :change       {:delay "3m"}
 ;;          :bug          {:delay "1000d"
 ;;                         :max-status 0       ;; only open, unacked, unowned
 ;;                         :max-priority 0     ;; only non-urgent, non-important
 ;;                         :op-answered false}  ;; only when OP is NOT the last to reply
 ;;          :request      {:delay "1000d"
 ;;                         :max-status 0}}

 ;; Global export formats (optional) — controls which per-type feed files
 ;; are generated (e.g. bugs.json, patches.xml, announcements.org).
 ;; Also controls which of reports.json/org/rss are emitted during `bb export all`.
 ;; When set per source, it overrides the global value.
 ;; Default: ["json" "org" "rss"]
 ;; :export-formats ["json" "rss"]

 ;; Global export reports (optional) — restricts which report types are
 ;; included in all exports (JSON, RSS, Org, HTML, stats, patches).
 ;; When set per source, it overrides the global value.
 ;; Default: all types (when absent).
 ;; :export-reports #{:bug :patch :request :announcement :release :change}

 ;; Supported report types (optional) — restricts which report types
 ;; are detected and created during digest.  Emails matching a disabled
 ;; type are silently ignored (they still thread as descendants).
 ;; When set per source, it overrides the global value.
 ;; Default: all types (when absent).
 ;; :report-types #{:bug :patch :request :announcement :release :change}
 ;;
 ;; Example — a source that only tracks bugs and patches:
 ;; {:name "kernel-patches"
 ;;  :list "lkml.org"
 ;;  :report-types #{:bug :patch}}

 ;; Logging (optional — logs go to stdout only when absent)
 ;; :logging {:file     "logs/bark.log"    ;; path to log file (optional)
 ;;           :level    :warn              ;; minimum level for file (:debug :info :warn :error)
 ;;           :max-size "10MB"             ;; rotate when file exceeds this size (default: 10MB)
 ;;           :backlog  5                  ;; number of rotated files to keep (default: 5)
 ;;           ;; Email logging — requires :notifications :smtp to be configured.
 ;;           :email    {:to    "admin@example.com"  ;; recipient address
 ;;                      :level :error}}             ;; minimum level to email (default: :error)

 ;; Maintenance (optional) — settings for `bb maintenance`.
 ;; Run only when the JVM daemon is stopped.
 ;;   :orphan-delay — delete orphan emails older than this duration.
 ;;                   An orphan is an email not referenced by any report
 ;;                   and not sent by a maintainer or admin.
 ;;                   Accepts a duration string ("30d", "6w", "3m", "1y")
 ;;                   or an integer (days). Default: 90 days.
 ;; :maintenance {:orphan-delay "90d"}

 }
