# systemd unit for BARK in watch mode.
# Install as /etc/systemd/system/bark.service (root) or
# ~/.config/systemd/user/bark.service (user).
#
# For the root install, create the service user first:
#   useradd -r -d /opt/bark -s /usr/sbin/nologin bark
#   chown -R bark: /opt/bark
# (Omit this step and the User= line below for a --user install.)
#
# After editing paths below:
#   systemctl [--user] daemon-reload
#   systemctl [--user] enable --now bark
#   systemctl [--user] status bark
#   journalctl [--user] -u bark -f

[Unit]
Description=BARK — email-driven report tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Drop User= for the --user installation path.
User=bark
WorkingDirectory=/opt/bark
# Run `bb build-jar` once to produce target/bark.jar and bin/bark.
ExecStart=/opt/bark/bin/bark --watch

# Resilience: restart on crash, wait 30 s before retrying.
Restart=on-failure
RestartSec=30s

# Only stderr is used by default (no :logging :file in config).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
