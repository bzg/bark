{:paths ["src" "resources" "classes"]

 :deps
 {org.clojure/clojure        {:mvn/version "1.12.4"}
  org.clojars.bzg/fetch-imap {:mvn/version "0.3.3"}
  datalevin/datalevin        {:mvn/version "0.10.7"}
  org.clojure/data.json      {:mvn/version "2.5.2"}
  org.jsoup/jsoup            {:mvn/version "1.22.1"}
  com.taoensso/timbre        {:mvn/version "6.8.0"}
  com.draines/postal         {:mvn/version "2.0.5"}}

 :aliases
 {;; Main daemon: ingest + digest + periodic expire
  :run
  {:main-opts ["-m" "bark.main"]
   :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
              "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"]}

  ;; Tests
  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                       :git/sha "dfb30dd"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     bark.test-runner/test
   :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                 "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                 "--enable-native-access=ALL-UNNAMED"]}

  ;; Build uberjar
  :uberdeps
  {:extra-deps    {uberdeps/uberdeps {:mvn/version "1.4.0"}}
   :replace-paths []
   :main-opts     ["-m" "uberdeps.uberjar"]
   :jvm-opts      ["--add-opens=java.base/java.nio=ALL-UNNAMED"
              "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"]}}}
