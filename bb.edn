{:paths ["src" "scripts" "resources"]
 :tasks
 {;; The JVM daemon handles ingest, digest and expire:
 ;;   clojure -M:run                   (daemon)
 ;;   clojure -M:run -- --fetch 4d  (recovery)
 ;;
 ;; Export and notify are read-only bb scripts:

  export     {:doc  "Export reports: bb export [--force] [--index-only] [-n source] [-p 1|2|3] [-s 1-7]"
              :task (apply shell "bb scripts/bark-export.clj" *command-line-args*)}

  notify     {:doc  "Send notification emails: bb notify [--dry-run] [--force] [--debug]"
              :task (apply shell "bb scripts/bark-notify.clj" *command-line-args*)}

  clean      {:doc  "Remove all files in public/"
              :task (let [dir (clojure.java.io/file "public")]
                     (when (.exists dir)
                      (doseq [f (reverse (file-seq dir))]
                       (when-not (= f dir)
                        (.delete f)
                        (println "Deleted" (.getPath f))))))}

  test-config {:doc  "Validate config.edn (pass path as arg, default: ./config.edn)"
               :task (apply shell "bb scripts/validate-config.clj" *command-line-args*)}

  maintenance {:doc  "Purge orphan emails: bb maintenance [--delete] [--verbose] [-n source]"
               :task (apply shell "bb scripts/bark-maintenance.clj" *command-line-args*)}

  rebuild-history {:doc  "Replay a mail archive across era configs: bb rebuild-history [--history PATH] [--fresh] [--dry-run]"
                   :task (apply shell "bb scripts/bark-rebuild-history.clj" *command-line-args*)}

  build-jar  {:doc  "Build target/bark.jar + bin/bark wrapper (one-shot uberjar build)"
              :task (do
                      (let [classes (clojure.java.io/file "classes")
                            bin     (clojure.java.io/file "bin")
                            wrapper (clojure.java.io/file "bin/bark")]
                        (.mkdirs classes)
                        (.mkdirs bin)
                        (shell "clojure" "-M" "-e" "(compile 'bark.main)")
                        (shell "clojure" "-M:uberdeps" "--main-class" "bark.main")
                        (spit wrapper
                              (str "#!/bin/sh\n"
                                   "# Auto-generated by `bb build-jar`.  Runs BARK via java\n"
                                   "# with the JVM flags Datalevin requires.\n"
                                   "exec java \\\n"
                                   "  --add-opens=java.base/java.nio=ALL-UNNAMED \\\n"
                                   "  --add-opens=java.base/sun.nio.ch=ALL-UNNAMED \\\n"
                                   "  --enable-native-access=ALL-UNNAMED \\\n"
                                   "  -jar \"$(dirname \"$0\")/../target/bark.jar\" \"$@\"\n"))
                        (.setExecutable wrapper true)
                        (println "Built target/bark.jar and bin/bark")))}

  ;; Integration tests: clojure -M:test

  test-smtp  {:doc  "Test SMTP config: bb test-smtp [--to addr] [--send] (default = validate only)"
              :task (apply shell "bb scripts/bark-email-test.clj" *command-line-args*)}}}
