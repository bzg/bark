{:paths ["src" "resources"]
 :tasks
 {;; The JVM daemon handles ingest, digest and expire:
 ;;   clojure -M:run                   (daemon)
 ;;   clojure -M:run -- --initial-fetch 4d  (recovery)
 ;;
 ;; Export and notify are read-only bb scripts:

  export     {:doc  "Export reports: bb export [json|rss|org|html|stats|all] [-n source] [-p 1|2|3] [-s 1-7] [--force]"
              :task (apply shell "bb scripts/bark-export.clj" *command-line-args*)}

  notify     {:doc  "Send notification emails: bb notify [--dry-run] [--force] [--debug]"
              :task (apply shell "bb scripts/bark-notify.clj" *command-line-args*)}

  clean      {:doc  "Remove all files in classes/, public/ and docs/"
              :task (doseq [d ["public" "classes" "docs"]]
                      (let [dir (clojure.java.io/file d)]
                        (when (.exists dir)
                          (doseq [f (reverse (file-seq dir))]
                            (when-not (or (= f dir)
                                          (.endsWith (.getPath f) ".org"))
                              (.delete f)
                              (println "Deleted" (.getPath f)))))))}

  test-config {:doc  "Validate config.edn (pass path as arg, default: ./config.edn)"
               :task (apply shell "bb scripts/validate-config.clj" *command-line-args*)}

  maintenance {:doc  "Purge orphan emails: bb maintenance [--delete] [--verbose] [-n source]"
               :task (apply shell "bb scripts/bark-maintenance.clj" *command-line-args*)}

  ;; Integration tests: clojure -M:test

  test-smtp  {:doc  "Test SMTP config: bb test-smtp [--to addr] [--dry-run]"
              :task (apply shell "bb scripts/bark-email-test.clj" *command-line-args*)}}}
